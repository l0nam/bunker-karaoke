# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Host panel authentication (use a long random value for SESSION_SECRET)
HOST_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret

# Optional integrations
GENIUS_ACCESS_TOKEN=
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/bunkeronline

# Public canonical origin. Set this to the actual production URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
